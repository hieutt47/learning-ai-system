# Sao chép thành .env.local (không commit) rồi chỉnh.

# Gốc API. Mặc định /api/v1 đi qua proxy của Vite tới backend (xem vite.config.ts).
VITE_API_BASE_URL=/api/v1

# CHỈ DÙNG KHI DEV, trong lúc auth chưa merge: backend đang dùng stub đọc header X-User-Id.
# Để trống thì không gửi. Xóa khi đã có đăng nhập JWT.
VITE_DEV_USER_ID=
# Vai trò để hiển thị menu khi chưa có /users/me: GUEST | STUDENT | TEACHER | ADMIN
VITE_DEV_ROLE=TEACHER
# Tên hiện ở ô tài khoản khi chưa có /users/me (để trống: "Giảng viên (dev)"...)
VITE_DEV_USER_NAME=
