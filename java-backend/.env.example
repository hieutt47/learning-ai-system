DBMS_CONNECTION=jdbc:mysql://localhost:3306/learningai
DBMS_USERNAME=your_username
DBMS_PASSWORD=your_password
JWT_SIGNING_KEY=your_jwt_signing_key
AUTH_COOKIE_SECURE=false

# AI (M4): mock = AI giả để demo offline (mặc định); llm = gọi AI thật theo định dạng OpenAI Chat Completions
AI_PROVIDER=mock
AI_BASE_URL=your-url-here
AI_MODEL=model
AI_API_KEY=your-key-here
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_SOURCE_CHARS=20000
AI_SOURCE_STRATEGY=spread
AI_JSON_MODE=false
AI_TEMPERATURE=0.3

# Chưa cần email xác minh thì chưa cần điền
MAIL_USERNAME=
MAIL_PASSWORD=

